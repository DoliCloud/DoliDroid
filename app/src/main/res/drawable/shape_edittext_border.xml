<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fond -->
    <solid android:color="#FFFFFF"/>

    <!-- Bordure -->
    <stroke
        android:width="1.5dp"
        android:color="#9E9E9E"/>

    <!-- Corner -->
    <corners android:radius="6dp"/>

    <!-- Padding -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp"/>
</shape>
